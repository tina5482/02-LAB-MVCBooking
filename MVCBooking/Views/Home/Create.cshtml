@model HotelBooking

<h2>Kreiraj novi booking</h2>

<form asp-controller="Home" asp-action="CreateBooking" method="post">
    <div class="mb-3">
        <label class="form-label">Ime gosta</label>
        <input asp-for="GuestName" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Broj sobe</label>
        <input asp-for="RoomNumber" type="number" class="form-control" />
    </div>
    <button type="submit" class="btn btn-success">Spremi</button>
</form>
