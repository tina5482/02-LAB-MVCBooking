@model List<HotelBooking>

<h2>Lista svih booking-a</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Ime Gosta</th>
            <th>Broj Sobe</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var booking in Model)
            {
                <tr>
                    <td>@booking.Id</td>
                    <td>@booking.GuestName</td>
                    <td>@booking.RoomNumber</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="3" class="text-center">Nema dostupnih booking-a.</td>
            </tr>
}
    </tbody>
</table>

<a href="@Url.Action("Create", "Home")" class="btn btn-primary">Dodaj novi booking</a>

